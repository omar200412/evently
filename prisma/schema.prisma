// Evently — Postgres schema.
//
// Column names are snake_case via @map because that is the convention Postgres
// tooling expects; the JS side keeps camelCase. Every timestamp is timestamptz:
// storing a wall-clock time without an offset makes "when does this event start"
// unanswerable the moment two clients sit in different zones.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// A booking is never deleted, only flipped to CANCELLED, so status has to be a
/// real enum: the database rejects a typo that a plain text column would store.
enum BookingStatus {
  CONFIRMED
  CANCELLED
}

model Venue {
  id       String @id @default(uuid()) @db.Uuid
  name     String @db.VarChar(200)
  city     String @db.VarChar(120)
  capacity Int

  events Event[]

  @@index([name])
  @@map("venues")
}

model User {
  id    String @id @default(uuid()) @db.Uuid
  email String @unique @db.VarChar(255)
  name  String @db.VarChar(200)

  bookings Booking[]

  @@map("users")
}

model Event {
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @db.VarChar(200)
  description String   @default("") @db.VarChar(2000)
  venueId     String   @map("venue_id") @db.Uuid
  startsAt    DateTime @map("starts_at") @db.Timestamptz(3)
  capacity    Int
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // DELETE /v1/events/:id is a hard delete, so the bookings that point at the
  // event have to go with it — a booking for an event that no longer exists is
  // not history, it is a dangling row.
  venue    Venue     @relation(fields: [venueId], references: [id], onDelete: Restrict)
  bookings Booking[]

  // Every list query orders by startsAt and optionally filters by venue, so
  // these two cover the read path without a sort step.
  @@index([startsAt])
  @@index([venueId, startsAt])
  @@map("events")
}

model Booking {
  id          String        @id @default(uuid()) @db.Uuid
  eventId     String        @map("event_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  seats       Int
  status      BookingStatus @default(CONFIRMED)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  cancelledAt DateTime?     @map("cancelled_at") @db.Timestamptz(3)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One row per user per event, forever. Re-booking after a cancellation revives
  // this row rather than inserting a second one, which is what lets the database
  // itself enforce "one active booking per user per event" instead of trusting
  // the application to check first.
  @@unique([userId, eventId], map: "bookings_user_id_event_id_key")
  // "my bookings" — WHERE user_id = ? — is the hot lookup, and the unique index
  // above already serves it: a B-tree on (user_id, event_id) is sorted by
  // user_id first, so it seeks straight to that user's rows. Adding a standalone
  // @@index([userId]) does not help. The planner does switch to it, being the
  // narrower of the two, but reads the same three pages to reach the same tuple
  // — while every insert, update and delete then has to maintain a second
  // B-tree. Measured, not assumed: `npm run prove:index` prints all three states
  // (no index / compound only / both) side by side.
  //
  // The capacity check sums seats for one event's CONFIRMED rows on every
  // booking attempt. This one is not redundant — no other index leads with
  // event_id — and it is what keeps that sum off a full table scan.
  @@index([eventId, status])
  @@map("bookings")
}
