# Copy to .env and adjust. Nothing in the app reads process.env directly —
# every value below is validated once in src/config/index.js at boot, so a
# mistake here stops the process with a message naming the variable rather than
# surfacing as a 500 on the first request that reaches the database.

# The one variable with no safe default: guessing it would mean silently
# writing to the wrong database.
#
#   Docker (docker compose up):  postgresql://evently:evently@db:5432/evently?schema=public
#   Local  (npm run db:local):   postgresql://evently:evently@localhost:55432/evently?schema=public
DATABASE_URL="postgresql://evently:evently@localhost:5432/evently?schema=public"

PORT=3000

# `production` disables the x-user-id header in src/middleware/currentUser.js.
# Leave it disabled anywhere real — that header is account takeover otherwise.
NODE_ENV=development

# Serializable transactions abort on conflict instead of blocking, so the
# booking path retries them. Zero disables retrying entirely, which turns
# ordinary contention into 500s.
BOOKING_MAX_RETRIES=5

# Base for the jittered exponential backoff between those retries.
BOOKING_BACKOFF_MS=20

# Stands in for authentication. Must be a real row in `users` or every booking
# fails its foreign key. Defaults to the first seeded user.
# CURRENT_USER_ID=11111111-0000-4000-8000-000000000001

# `silent` suppresses Prisma's query-error log. The proof scripts set it,
# because they provoke write conflicts deliberately and report them properly.
# DB_LOG=silent

# ── Session 4: authentication ────────────────────────────────────────────────

# Signing key for access tokens. REQUIRED, no default, minimum 32 characters —
# a short key is brute-forceable offline, and anyone who recovers it can mint a
# token for any user with any role. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# How long an access token stays valid. Short on purpose: an access token cannot
# be revoked, so this is the window a stolen one keeps working.
ACCESS_TOKEN_TTL=15m

# How long a refresh token lives. This one *is* revocable — it is a row.
REFRESH_TOKEN_TTL_DAYS=7

# bcrypt work factor. Higher is slower for everyone, attackers included, which
# is the point. Tests drop to 4 automatically so the suite stays usable.
BCRYPT_ROUNDS=12

# Whether the refresh cookie carries the Secure flag. Forced on, and enforced,
# when NODE_ENV=production; only settable here so http://localhost works.
COOKIE_SECURE=false

# Comma-separated allowlist. Not a reflected origin and never "*" in production —
# with credentials enabled, echoing back whatever Origin arrives means any site
# can make authenticated requests as your users.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
